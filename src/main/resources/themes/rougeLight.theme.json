{
  "name": "Rouge Light",
  "author": "Shubham",
  "dark": false,
  "editorScheme": "/themes/rougeLight.xml",
  "colors": {
    "tree_cell_active": "#ccd7daff",
    "main_bg": "#E2E0D9",
    "island_border": "#F5EBE1",
    "background": "#F5EBE1",
    "hover": "#E9DFD5",
    "selection_background": "#E2E0D9"
  },
  "ui": {
    "*": {
      "background": "background",
      "foreground": "#585858",
      "highlight": "#e7e7e8ff",
      "selectionBackground": "tree_cell_active",
      "selectionInactiveBackground": "tree_cell_active",
      "selectionForeground": "#546e7aff",
      "button": "#f3f4f5ff",
      "secondaryBackground": "#ffffffff",
      "disabled": "#d2d4d5ff",
      "contrast": "#eeeeeeff",
      "tableSelected": "#e7e7e8ff",
      "secondBorder": "#d3e1e8ff",
      "treeSelection": "#80cbc440",
      "notifications": "#eae8e8ff",
      "accent": "#00bcd4ff",
      "excluded": "tree_cell_active"
    },
    "Islands": 1,
    "Island": {
      "arc": 20,
      "borderWidth": 4,
      "borderColor": "island_border",
      "inactiveAlpha": 0.44,
      "inactiveAlphaInStatusBar": {
        "os.mac": 0.2,
        "os.windows": 0.2,
        "os.linux": 0.15
      }
    },
    "MainWindow.background": "main_bg",
    "DefaultTabs": {
      "background": "background",
      "borderColor": "background"
    },
    "ToolWindow": {
      "Header": {
        "inactiveBackground": "background",
        "background": "background"
      },
      "background": "background"
    },
    "Plugins": {
      "Button": {
        "installBackground": "#144d69",
        "updateBackground": "#144d69",
        "installForeground": "#ffffff",
        "installFillForeground": "#ffffff",
        "updateForeground": "#ffffff"
      }
    },
    "EditorTabs": {
      "background": "background",
      "underTabsBorderColor": "background",
      "underlinedTabBackground": "selection_background",
      "underlinedBorderColor": "selection_background",
      "inactiveUnderlinedTabBackground": "selection_background",
      "inactiveUnderlinedTabBorderColor": "selection_background",
      "hoverBackground": "hover",
      "tabInsets": "-6,8,-6,8",
      "tabInsets.compact": "-2,6,-2,4",
      "tabContentActionsRightInsets": "0,2,0,2"
    },
    "Popup": {
      "Header.activeBackground": "#F5EBE1"
    },
    "TabbedPane": {
      "hoverColor": "#F5EBE1"
    },
    "Button": {
      "focus": "#F5EBE1"
    },
    "ActionButton": {
      "hoverBackground": "hover",
      "hoverBorderColor": "background",
      "pressedBackground": "background",
      "pressedBorderColor": "background"
    },
    "RunWidget": {
      "iconColor": "#565E70",
      "foreground": "#000000",
      "runningBackground": "#369650",
      "stopBackground": "#E55765",
      "hoverBackground": "#00000022",
      "pressedBackground": "#00000028",
      "runIconColor": "#369650",
      "stopIconColor": "#FFFFFF",
      "runningIconColor": "#FFFFFF"
    }
  }
}
