{
  "author": "Shubham",
  "dark": false,
  "name": "Vitesse Light",
  "editorScheme": "/themes/vitesseLight.xml",
  "colors": {
    "tab_background": "#D3D3D3",
    "transparent": "#00000000",
    "tree_cell_active": "#ccd7daff",
    "main_bg": "#dadadb",
    "island_border": "#dadadb",
    "user_message_background": "#D3D3D3",
    "focus_color": "#b56959",
    "foreground": "#606060"
  },
  "ui": {
    "*": {
      "background": "#F1F0E9",
      "foreground": "foreground",
      "highlight": "#e7e7e8ff",
      "selectionBackground": "tree_cell_active",
      "selectionInactiveBackground": "tree_cell_active",
      "selectionForeground": "#546e7aff",
      "button": "#f3f4f5ff",
      "secondaryBackground": "#ffffffff",
      "disabled": "#d2d4d5ff",
      "contrast": "#eeeeeeff",
      "tableSelected": "#e7e7e8ff",
      "secondBorder": "#d3e1e8ff",
      "treeSelection": "#80cbc440",
      "notifications": "#eae8e8ff",
      "accent": "#00bcd4ff",
      "excluded": "tree_cell_active"
    },
    "Islands": 1,
    "Island": {
      "arc": 20,
      "borderWidth": 8,
      "borderColor": "island_border",
      "inactiveAlpha": 0.44,
      "inactiveAlphaInStatusBar": {
        "os.mac": 0.2,
        "os.windows": 0.2,
        "os.linux": 0.15
      }
    },
    "MainWindow.background": "main_bg",
    "DefaultTabs": {
      "background": "#F1F0E9",
      "borderColor": "#F1F0E9"
    },
    "ToolWindow": {
      "Header": {
        "inactiveBackground": "#F1F0E9"
      }
    },
    "Plugins": {
      "Button": {
        "installBackground": "#144d69",
        "updateBackground": "#144d69",
        "installForeground": "#ffffff",
        "installFillForeground": "#ffffff",
        "updateForeground": "#ffffff"
      }
    },
    "EditorTabs": {
      "background": "#F1F0E9",
      "underTabsBorderColor": "#F1F0E9",
      "underlinedTabBackground": "#D3D3D3",
      "underlinedBorderColor": "#D3D3D3",
      "inactiveUnderlinedTabBackground": "#D3D3D3",
      "inactiveUnderlinedTabBorderColor": "#D3D3D3",
      "hoverBackground": "#dadadb",
      "tabInsets": "-6,8,-6,8",
      "tabInsets.compact": "-2,6,-2,4",
      "tabContentActionsRightInsets": "0,2,0,2"
    },
    "Popup": {
      "Header.activeBackground": "#F1F0E9"
    },
    "TabbedPane": {
      "hoverColor": "#F1F0E9"
    },
    "Button": {
      "focus": "#F1F0E9"
    },
    "ActionButton": {
      "hoverBackground": "tree_cell_active",
      "hoverBorderColor": "transparent",
      "pressedBackground": "tree_cell_active",
      "pressedBorderColor": "transparent",
      "focusedBorderColor": "transparent",
      "hoverSeparatorColor": "tree_cell_active"
    },
    "RunWidget": {
      "iconColor": "#565E70",
      "foreground": "#000000",
      "runningBackground": "#369650",
      "stopBackground": "#E55765",
      "hoverBackground": "#00000022",
      "pressedBackground": "#00000028",
      "runIconColor": "#369650",
      "stopIconColor": "#FFFFFF",
      "runningIconColor": "#FFFFFF"
    },
    "AIAssistantInput": {
      "background": "user_message_background"
    },
    "AIAssistant": {
      "Chat": {
        "StepCard": {
          "Default": {
            "background.color": "user_message_background",
            "border.color": "user_message_background",
            "Content.background.color": "user_message_background",
            "Shortcut.background.color": "#F1F0E9"
          }
        }
      }
    },
    "HelpBrowser": {
      "UserMessage": {
        "background": "user_message_background",
        "Snippet": {
          "border": "user_message_background",
          "MoreLines": {
            "background": "user_message_background",
            "hoverBackground": "user_message_background"
          }
        }
      }
    },
    "Component": {
      "infoForeground": "foreground",
      "focusColor": "focus_color",
      "focusedBorderColor": "focus_color",
      "focusWidth": 1
    }
  }
}
