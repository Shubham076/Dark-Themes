    "info": "#397fb7",
    "success": "#30a25e",
    "background": "#FEFEFE",
    "hover": "#E6EDF5"
  },
  "ui": {
    "*": {
      "excluded": "tree_cell_active",
      "arc": "7",
      "foreground": "primary_foreground",
      "background": "background",
      "selectionForeground": "primary_foreground",
      "selectionInactiveForeground": "primary_foreground",
      "selectionBackground": "tree_cell_active",
