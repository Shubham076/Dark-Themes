      "focusColor": "hover_background",
      "hoverColor": "hover_background",
      "underlineColor": "line_color",
      "contentAreaColor": "hover_background"
    },
    "Table": {
      "gridColor": "border_color",
      "hoverBackground": "hover_background",
      "lightSelectionBackground": "selection_background"
    },
    "TableHeader": {
      "bottomSeparatorColor": "separator_color"
