      "inactiveBackground": "menu_background",
      "disabledBackground": "menu_background",
      "borderColor": "border_color",
      "separatorColor": "separator_color",
      "iconColor": "accent_color"
    },
    "Islands": 1,
    "Island": {
      "arc": 20,
      "borderWidth": 4,
      "borderColor": "island_border",
      "inactiveAlpha": 0.44,
      "inactiveAlphaInStatusBar": {
        "os.mac": 0.2,
        "os.windows": 0.2,
        "os.linux": 0.15
      }
    },
    "MainWindow.background": "main_bg",
    "Borders": {
      "color": "border_color",
      "ContrastBorderColor": "border_color"
    },
    "Button": {
