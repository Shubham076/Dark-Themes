{
  "name": "Brackets Light",
  "author": "Shubham Dogra",
  "dark": false,
  "editorScheme": "/themes/bracketsLight.xml",
  "colors": {
    "tree_cell_active": "#D4DDE7",
    "main_bg": "#D4DDE7",
    "island_border": "#FEFEFE",
    "border_color": "#c5d1d7",
    "separator_color": "#c5d1d7",
    "editor_background": "#fdfeff",
    "menu_background": "#e4ecef",
    "side_panel_background": "#d0e0e8",
    "header_background": "#c7dae1",
    "input_background": "#fdfeff",
    "tab_hover_background": "#f6d4c8",
    "hover_background": "#d5d8e7",
    "selection_background": "#D4DDE7",
    "selection_inactive_background": "#c3dbe5",
    "line_color": "#ED7E5A",
    "alternate_background": "#ED7E5A",
    "tab_color": "#fdfeff",
    "search_match_background": "#f6d4c8",
    "accent_color": "#1a536e",
    "primary_foreground": "#0e3448",
    "secondary_foreground": "#567b8a",
    "error": "#CE5E5E",
