{
  "name": "Noctis Minimus",
  "author": "Shubham",
  "dark": true,
  "editorScheme": "/themes/noctisMinimus.xml",
  "colors": {
    "tree_cell_active": "#273b48",
    "main_bg": "#2A3F4C",
    "island_border": "#1B2932",
    "background": "#1B2932",
    "background_light": "#2A3F4C",
    "hover": "#263E4D",
    "user_message_background": "background_light",
    "focus_color": "#cd8b72"
  },
  "ui": {
    "*": {
      "background": "background",
      "foreground": "#c5cdd3",
      "highlight": "#425b67ff",
      "selectionBackground": "tree_cell_active",
      "selectionInactiveBackground": "tree_cell_active",
      "selectionForeground": "#ffffffff",
      "button": "#2e3c43ff",
      "secondaryBackground": "#32424aff",
      "disabled": "#415967ff",
      "contrast": "#1e272cff",
      "tableSelected": "#314549ff",
      "secondBorder": "#2a373eff",
      "treeSelection": "#00485c",
      "notifications": "#323232ff",
      "accent": "#009688ff",
      "excluded": "tree_cell_active"
    },
    "Islands": 1,
    "Island": {
      "arc": 20,
      "borderWidth": 8,
      "borderColor": "island_border",
      "inactiveAlpha": 0.44,
      "inactiveAlphaInStatusBar": {
        "os.mac": 0.2,
        "os.windows": 0.2,
        "os.linux": 0.15
      }
    },
    "MainWindow.background": "main_bg",
    "DefaultTabs": {
      "background": "background",
      "borderColor": "background"
    },
    "EditorTabs": {
      "background": "background",
      "underTabsBorderColor": "background",

      "underlinedTabBackground": "background_light",
      "underlinedBorderColor": "background_light",

      "inactiveUnderlinedTabBackground": "background_light",
      "inactiveUnderlinedTabBorderColor": "background_light",

      "hoverBackground": "hover",

      "tabInsets": "-6,8,-6,8",
      "tabInsets.compact": "-2,6,-2,4",
      "tabContentActionsRightInsets": "0,2,0,2"
    },
    "ToolWindow": {
      "Header": {
        "inactiveBackground": "background",
        "background": "background"
      },
      "background": "background"
    },
    "Plugins": {
      "Button": {
        "installBackground": "#2d4453",
        "updateBackground": "#2d4453",
        "installForeground": "#ffffff",
        "installFillForeground": "#ffffff",
        "updateForeground": "#ffffff"
      }
    },
    "Popup": {
      "Header.activeBackground": "background"
    },
    "TabbedPane": {
      "hoverColor": "#152027"
    },
    "Button": {
      "focus": "#152027"
    },
    "ActionButton": {
      "hoverBackground": "hover",
      "hoverBorderColor": "background",
      "pressedBackground": "background",
      "pressedBorderColor": "background"
    },
    "HelpBrowser": {
      "UserMessage": {
        "background": "user_message_background",
        "Snippet": {
          "border": "user_message_background",
          "MoreLines": {
            "background": "user_message_background",
            "hoverBackground": "user_message_background"
          }
        }
      }
    },
    "Component": {
      "focusColor": "focus_color",
      "focusedBorderColor": "focus_color",
      "focusWidth": 1
    }
  }
}