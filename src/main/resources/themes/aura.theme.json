{
  "name": "Aura",
  "author": "Shubham",
  "dark": true,
  "editorScheme": "/themes/Aura.xml",
  "colors": {
    "main_bg": "#2f3859",
    "island_border": "#293152FF",
    "background": "#293152FF",
    "background_light": "#2f3859",
    "tab_background": "#394364",
    "tree_cell_active": "#435460",
    "transparent": "#00000000",
    "user_message_background": "tab_background",
    "focus_color": "#fbbc9f"
  },
  "ui": {
    "*": {
      "background": "background",
      "foreground": "#b0bec5ff",
      "highlight": "#425b67ff",
      "selectionBackground": "tree_cell_active",
      "selectionInactiveBackground": "tree_cell_active",
      "selectionForeground": "#ffffffff",
      "button": "#2e3c43ff",
      "secondaryBackground": "#32424aff",
      "disabled": "#415967ff",
      "contrast": "#1e272cff",
      "tableSelected": "#314549ff",
      "secondBorder": "#2a373eff",
      "treeSelection": "#00485c",
      "notifications": "background_light",
      "accent": "#009688ff",
      "excluded": "tree_cell_active"
    },
    "Islands": 1,
    "Island": {
      "arc": 20,
      "borderWidth": 8,
      "borderColor": "island_border",
      "inactiveAlpha": 0.44,
      "inactiveAlphaInStatusBar": {
        "os.mac": 0.2,
        "os.windows": 0.2,
        "os.linux": 0.15
      }
    },
    "MainWindow.background": "main_bg",
    "DefaultTabs": {
      "background": "background",
      "borderColor": "background"
    },
    "ToolWindow": {
      "Header": {
        "inactiveBackground": "background",
        "background": "background"
      },
      "background": "background"
    },
    "Plugins": {
      "Button": {
        "installBackground": "#253989",
        "updateBackground": "#253989",
        "installForeground": "#ffffff",
        "installFillForeground": "#ffffff",
        "updateForeground": "#ffffff"
      }
    },
    "EditorTabs": {
      "background": "background",
      "underTabsBorderColor": "background",

      "underlinedTabBackground": "tab_background",
      "underlinedBorderColor": "tab_background",

      "inactiveUnderlinedTabBackground": "tab_background",
      "inactiveUnderlinedTabBorderColor": "tab_background",

      "hoverBackground": "hover",

      "tabInsets": "-6,8,-6,8",
      "tabInsets.compact": "-2,6,-2,4",
      "tabContentActionsRightInsets": "0,2,0,2"
    },
    "Popup": {
      "Header.activeBackground": "background",
      "background": "background_light",
      "borderColor": "background_light"
    },
    "List": {
      "background": "background_light",
      "selectionBackground": "tree_cell_active"
    },
    "TabbedPane": {
      "hoverColor": "#1B2443"
    },
    "Button": {
      "focus": "#1B2443"
    },
    "ActionButton": {
      "hoverBackground": "tree_cell_active",
      "hoverBorderColor": "transparent",
      "pressedBackground": "tree_cell_active",
      "pressedBorderColor": "transparent",
      "focusedBorderColor": "transparent",
      "hoverSeparatorColor": "tree_cell_active"
    },
    "ToolTip": {
      "background": "background_light",
      "borderColor": "background_light"
    },
    "Notification": {
      "background": "background_light",
      "borderColor": "background_light"
    },
    "EditorNotificationBar": {
      "background": "background_light",
      "borderColor": "background_light"
    },
    "SuggestedPluginNotification": {
      "background": "background_light",
      "borderColor": "background_light"
    },
    "HelpBrowser": {
      "UserMessage": {
        "background": "user_message_background",
        "Snippet": {
          "border": "user_message_background",
          "MoreLines": {
            "background": "user_message_background",
            "hoverBackground": "user_message_background"
          }
        }
      }
    },
    "Component": {
      "focusColor": "focus_color",
      "focusedBorderColor": "focus_color",
      "focusWidth": 1
    }
  }
}