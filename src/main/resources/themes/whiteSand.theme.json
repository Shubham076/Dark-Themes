{
  "name": "White Sand",
  "author": "Shubham",
  "dark": false,
  "editorScheme": "/themes/whiteSand.xml",
  "colors": {
    "tree_cell_active": "#E1D8CF",
    "main_bg": "#dad1c9",
    "island_border": "#EEE9E4",
    "background": "#EEE9E4",
    "foreground": "#585858",
    "background_light": "#E1D8CF",
    "tab_hover_background": "#d3cac2",
    "tab_background": "#d3cac2",
    "main_window_background": "#dad1c9",
    "action_btn_focus_background": "#bab1a9",
    "action_btn_hover_background": "#c1b8b0",
    "transparent": "#00000000",
    "user_message_background": "tab_background",
    "focus_color": "#888655"
  },
  "ui": {
    "*": {
      "background": "background",
      "foreground": "foreground",
      "highlight": "#e7e7e8ff",
      "selectionBackground": "tree_cell_active",
      "selectionInactiveBackground": "tree_cell_active",
      "selectionForeground": "foreground",
      "button": "#f3f4f5ff",
      "secondaryBackground": "#ffffffff",
      "disabled": "#d2d4d5ff",
      "contrast": "#eeeeeeff",
      "tableSelected": "#e7e7e8ff",
      "secondBorder": "#d3e1e8ff",
      "treeSelection": "#80cbc440",
      "notifications": "#eae8e8ff",
      "accent": "#00bcd4ff",
      "excluded": "tree_cell_active"
    },
    "Islands": 1,
    "Island": {
      "arc": 20,
      "borderWidth": 8,
      "borderColor": "island_border",
      "inactiveAlpha": 0.44,
      "inactiveAlphaInStatusBar": {
        "os.mac": 0.2,
        "os.windows": 0.2,
        "os.linux": 0.15
      }
    },
    "MainWindow.background": "main_bg",
    "DefaultTabs": {
      "background": "background",
      "borderColor": "background"
    },
    "ToolWindow": {
      "Header": {
        "inactiveBackground": "background",
        "background": "background"
      },
      "background": "background"
    },
    "Plugins": {
      "Button": {
        "installBackground": "#144d69",
        "updateBackground": "#144d69",
        "installForeground": "#ffffff",
        "installFillForeground": "#ffffff",
        "updateForeground": "#ffffff"
      }
    },
    "EditorTabs": {
      "background": "background",
      "underTabsBorderColor": "background",
      "underlinedTabBackground": "tab_background",
      "underlinedBorderColor": "tab_background",
      "inactiveUnderlinedTabBackground": "tab_background",
      "inactiveUnderlinedTabBorderColor": "tab_background",
      "hoverBackground": "tab_hover_background",
      "tabInsets": "-6,8,-6,8",
      "tabInsets.compact": "-2,6,-2,4",
      "tabContentActionsRightInsets": "0,2,0,2"
    },
    "Popup": {
      "Header.activeBackground": "background"
    },
    "TabbedPane": {
      "hoverColor": "background"
    },
    "Button": {
      "focus": "background"
    },
    "ActionButton": {
      "hoverBackground": "action_btn_hover_background",
      "focusedBorderColor": "transparent",
      "hoverBorderColor": "transparent",
      "pressedBackground": "action_btn_focus_background"
    },
    "RunWidget": {
      "iconColor": "#565E70",
      "foreground": "#000000",
      "runningBackground": "#369650",
      "stopBackground": "#E55765",
      "hoverBackground": "#00000022",
      "pressedBackground": "#00000028",
      "runIconColor": "#369650",
      "stopIconColor": "#FFFFFF",
      "runningIconColor": "#FFFFFF"
    },
    "HelpBrowser": {
      "UserMessage": {
        "background": "user_message_background",
        "Snippet": {
          "border": "user_message_background",
          "MoreLines": {
            "background": "user_message_background",
            "hoverBackground": "user_message_background"
          }
        }
      }
    },
    "Component": {
      "focusColor": "focus_color",
      "focusedBorderColor": "focus_color",
      "focusWidth": 1
    }
