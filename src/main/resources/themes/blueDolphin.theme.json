{
  "name": "Blue Dolphin",
  "author": "Shubham",
  "dark": true,
  "editorScheme": "/themes/blueDolphin.xml",
  "colors": {
    "tree_cell_active": "#2d617c",
    "main_bg": "#215670",
    "island_border": "#0f445b",
    "background": "#0f445b",
    "main_background": "#215670",
    "tree_selection": "#2d617c",
    "popup_background": "#1b506a",
    "tab_background": "#2d617c",
    "hover": "#1C4F67",
    "user_message_background": "tab_background",
    "focus_color": "#f5b8a0"
  },
  "ui": {
    "*": {
      "background": "background",
      "foreground": "#b0bec5ff",
      "highlight": "#425b67ff",
      "selectionBackground": "tree_cell_active",
      "selectionInactiveBackground": "tree_cell_active",
      "selectionForeground": "#ffffffff",
      "button": "#2e3c43ff",
      "secondaryBackground": "#32424aff",
      "disabled": "#415967ff",
      "contrast": "#1e272cff",
      "tableSelected": "#314549ff",
      "secondBorder": "#2a373eff",
      "treeSelection": "tree_selection",
      "notifications": "#323232ff",
      "accent": "#009688ff",
      "excluded": "tree_cell_active"
    },
    "Islands": 1,
    "Island": {
      "arc": 20,
      "borderWidth": 8,
      "borderColor": "island_border",
      "inactiveAlpha": 0.44,
      "inactiveAlphaInStatusBar": {
        "os.mac": 0.2,
        "os.windows": 0.2,
        "os.linux": 0.15
      }
    },
    "MainWindow.background": "main_bg",
    "DefaultTabs": {
      "background": "background",
      "borderColor": "background"
    },
    "EditorTabs": {
      "background": "background",
      "underTabsBorderColor": "background",

      "underlinedTabBackground": "tab_background",
      "underlinedBorderColor": "tab_background",

      "inactiveUnderlinedTabBackground": "tab_background",
      "inactiveUnderlinedTabBorderColor": "tab_background",

      "hoverBackground": "hover",

      "tabInsets": "-6,8,-6,8",
      "tabInsets.compact": "-2,6,-2,4",
      "tabContentActionsRightInsets": "0,2,0,2"
    },
    "Popup": {
      "Header.activeBackground": "popup_background",
      "background": "popup_background",
      "borderColor": "popup_background"
    },
    "List": {
      "background": "selectionBackground",
      "mainBackground": "tree_selection"
    },
    "ToolWindow": {
      "Header": {
        "inactiveBackground": "background",
        "background": "background"
      },
      "background": "background"
    },
    "Plugins": {
      "Button": {
        "installBackground": "#005983ff",
        "updateBackground": "#005983ff",
        "installForeground": "#ffffff",
        "installFillForeground": "#ffffff",
        "updateForeground": "#ffffff"
      }
    },
    "TabbedPane": {
      "hoverColor": "#002b3f"
    },
    "Button": {
      "focus": "#002b3f"
    },
    "ActionButton": {
      "hoverBackground": "hover",
      "hoverBorderColor": "background",
      "pressedBackground": "background",
      "pressedBorderColor": "background"
    },
    "ToolTip": {
      "background": "popup_background",
      "borderColor": "popup_background"
    },
    "Notification": {
      "background": "popup_background",
      "borderColor": "popup_background"
    },
    "EditorNotificationBar": {
      "background": "popup_background",
      "borderColor": "popup_background"
    },
    "SuggestedPluginNotification": {
      "background": "popup_background",
      "borderColor": "popup_background"
    },
    "HelpBrowser": {
      "UserMessage": {
        "background": "user_message_background",
        "Snippet": {
          "border": "user_message_background",
          "MoreLines": {
            "background": "user_message_background",
            "hoverBackground": "user_message_background"
          }
        }
      }
    },
    "Component": {
      "focusColor": "focus_color",
      "focusedBorderColor": "focus_color",
      "focusWidth": 1
    }
  }
}