{
  "name": "Monokai Light",
  "author": "Shubham",
  "dark": false,
  "editorScheme": "/themes/monokaiLight.xml",
  "colors": {
    "tab_background": "#D3CDCC",
    "transparent": "#00000000",
    "tree_cell_active": "#ccd7daff",
    "main_bg": "#D3CDCC",
    "island_border": "#FAF4F2",
    "background": "#FAF4F2",
    "hover": "#E0DAD9",
    "background_light": "#D3CDCC",
    "user_message_background": "background_light",
    "focus_color": "#c6637c",
    "foreground": "#606060"
  },
  "ui": {
    "*": {
      "background": "background",
      "foreground": "foreground",
      "highlight": "#e7e7e8ff",
      "selectionBackground": "tree_cell_active",
      "selectionInactiveBackground": "tree_cell_active",
      "selectionForeground": "#546e7aff",
      "button": "#f3f4f5ff",
      "secondaryBackground": "#ffffffff",
      "disabled": "#d2d4d5ff",
      "border": "#d3cdcc",
      "contrast": "#eeeeeeff",
      "tableSelected": "#e7e7e8ff",
      "secondBorder": "#d3e1e8ff",
      "treeSelection": "#80cbc440",
      "notifications": "#eae8e8ff",
      "accent": "#00bcd4ff",
      "excluded": "tree_cell_active"
    },
    "Islands": 1,
    "Island": {
      "arc": 20,
      "borderWidth": 8,
      "borderColor": "island_border",
      "inactiveAlpha": 0.44,
      "inactiveAlphaInStatusBar": {
        "os.mac": 0.2,
        "os.windows": 0.2,
        "os.linux": 0.15
      }
    },
    "MainWindow.background": "main_bg",
    "DefaultTabs": {
      "background": "background",
      "borderColor": "background"
    },
    "EditorTabs": {
      "background": "background",
      "underTabsBorderColor": "background",
      "underlinedTabBackground": "background_light",
      "underlinedBorderColor": "background_light",
      "inactiveUnderlinedTabBackground": "background_light",
      "inactiveUnderlinedTabBorderColor": "background_light",
      "hoverBackground": "hover",
      "tabInsets": "-6,8,-6,8",
      "tabInsets.compact": "-2,6,-2,4",
      "tabContentActionsRightInsets": "0,2,0,2"
    },
    "Popup": {
      "Header.activeBackground": "background"
    },
    "ToolWindow": {
      "Header": {
        "inactiveBackground": "background",
        "background": "background"
      },
      "background": "background"
    },
    "TabbedPane": {
      "hoverColor": "#FAF4F2"
    },
    "Button": {
      "focus": "#FAF4F2"
    },
    "ActionButton": {
      "hoverBackground": "tree_cell_active",
      "hoverBorderColor": "transparent",
      "pressedBackground": "tree_cell_active",
      "pressedBorderColor": "transparent",
      "focusedBorderColor": "transparent",
      "hoverSeparatorColor": "tree_cell_active"
    },
    "RunWidget": {
      "iconColor": "#565E70",
      "foreground": "#000000",
      "runningBackground": "#369650",
      "stopBackground": "#E55765",
      "hoverBackground": "#00000022",
      "pressedBackground": "#00000028",
      "runIconColor": "#369650",
      "stopIconColor": "#FFFFFF",
      "runningIconColor": "#FFFFFF"
    },
    "AIAssistantInput": {
      "background": "user_message_background"
    },
    "AIAssistant": {
      "Chat": {
        "StepCard": {
          "Default": {
            "background.color": "user_message_background",
            "border.color": "user_message_background",
            "Content.background.color": "user_message_background",
            "Shortcut.background.color": "background"
          }
        }
      }
    },
    "HelpBrowser": {
      "UserMessage": {
        "background": "user_message_background",
        "Snippet": {
          "border": "user_message_background",
          "MoreLines": {
            "background": "user_message_background",
            "hoverBackground": "user_message_background"
          }
        }
      }
    },
    "Component": {
      "infoForeground": "foreground",
      "focusColor": "focus_color",
      "focusedBorderColor": "focus_color",
      "focusWidth": 1
    }
  }
}
