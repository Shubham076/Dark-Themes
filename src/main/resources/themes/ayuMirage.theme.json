{
  "name": "Ayu Mirage",
  "author": "Shubham",
  "dark": true,
  "editorScheme": "/themes/ayuMirage.xml",
  "colors": {
    "tree_cell_active": "#333b4fff",
    "main_bg": "#293847",
    "island_border": "#262c38",
    "background": "#262c38",
    "background_light": "#293847",
    "hover": "#2A363E",
    "user_message_background": "tree_cell_active",
    "focus_color": "#ffa759",
    "foreground": "#b0bec5ff"
  },
  "ui": {
    "*": {
      "background": "background",
      "foreground": "foreground",
      "highlight": "#425b67ff",
      "selectionBackground": "tree_cell_active",
      "tabBackground": "#2e3d4c",
      "selectionInactiveBackground": "tree_cell_active",
      "selectionForeground": "#ffffffff",
      "button": "#2e3c43ff",
      "secondaryBackground": "#32424aff",
      "disabled": "#f29e7480",
      "contrast": "#1e272cff",
      "tableSelected": "#314549ff",
      "secondBorder": "#2a373eff",
      "treeSelection": "#707a8cb3",
      "notifications": "#323232ff",
      "accent": "#009688ff",
      "excluded": "tree_cell_active"
    },
    "Islands": 1,
    "Island": {
      "arc": 20,
      "borderWidth": 8,
      "borderColor": "island_border",
      "inactiveAlpha": 0.44,
      "inactiveAlphaInStatusBar": {
        "os.mac": 0.2,
        "os.windows": 0.2,
        "os.linux": 0.15
      }
    },
    "MainWindow.background": "main_bg",
    "ToolWindow": {
      "Header": {
        "inactiveBackground": "background",
        "background": "background"
      },
      "background": "background"
    },
    "DefaultTabs": {
      "background": "tabBackground",
      "borderColor": "tabBackground"
    },
    "Plugins": {
      "Button": {
        "installBackground": "#3a4359ff",
        "updateBackground": "#3a4359ff",
        "installForeground": "#ffffff",
        "installFillForeground": "#ffffff",
        "updateForeground": "#ffffff"
      }
    },
    "EditorTabs": {
      "background": "tabBackground",
      "underTabsBorderColor": "tabBackground",

      "underlinedTabBackground": "tabBackground",
      "underlinedBorderColor": "tabBackground",

      "inactiveUnderlinedTabBackground": "tabBackground",
      "inactiveUnderlinedTabBorderColor": "tabBackground",

      "hoverBackground": "hover",

      "tabInsets": "-6,8,-6,8",
      "tabInsets.compact": "-2,6,-2,4",
      "tabContentActionsRightInsets": "0,2,0,2"
    },
    "Popup": {
      "Header.activeBackground": "background"
    },
    "TabbedPane": {
      "hoverColor": "#1f2430"
    },
    "Button": {
      "focus": "#1f2430"
    },
    "ActionButton": {
      "hoverBackground": "hover",
      "hoverBorderColor": "background",
      "pressedBackground": "background",
      "pressedBorderColor": "background"
    },
    "AIAssistantInput": {
      "background": "user_message_background"
    },
    "AIAssistant": {
      "Chat": {
        "StepCard": {
          "Default": {
            "background.color": "user_message_background",
            "border.color": "user_message_background",
            "Content.background.color": "user_message_background",
            "Shortcut.background.color": "background"
          }
        }
      }
    },
    "HelpBrowser": {
      "UserMessage": {
        "background": "user_message_background",
        "Snippet": {
          "border": "user_message_background",
          "MoreLines": {
            "background": "user_message_background",
            "hoverBackground": "user_message_background"
          }
        }
      }
    },
    "Component": {
      "infoForeground": "foreground",
      "focusColor": "focus_color",
      "focusedBorderColor": "focus_color",
      "focusWidth": 1
    }
  }
}